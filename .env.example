BIGQMT_ACCOUNT_ID=YOUR_ACCOUNT_ID
# BIGQMT_ACCOUNT_TYPE=STOCK

# start_serial_bridge.ps1 会在这个目录下找 bin.x64\XtItClient.exe，
# 并在桥接串口就绪后启动 QMT（QMT 自身负责自动登录和自动运行策略）。
# 不填时使用正在运行的 QMT 进程所在目录。
# BIGQMT_QMT_DIR=D:/gjzq_qmt

# Optional credentials for start_serial_bridge.ps1 -QmtMode login.
# BIGQMT_LOGIN_USER=
# BIGQMT_LOGIN_PASSWORD=

# QMT launch mode used by the GUI control panel.
# BIGQMT_QMT_MODE=exe
# BIGQMT_QMT_EXE=XtItClient.exe

# Serial bridge settings (the GUI control panel writes these too).
# BIGQMT_SERIAL_PORT=COM11
# BIGQMT_SERIAL_BAUDRATE=921600
# BIGQMT_SERIAL_MAX_FRAME_BYTES=8388608
# BIGQMT_SERIAL_VALKEY_PUBSUB=0

# Valkey connection for the client and the external serial bridge.
# BIGQMT_VALKEY_URL=valkey://127.0.0.1:6379/5
# BIGQMT_SERIAL_VALKEY_URL=valkey://127.0.0.1:6379/5

# Alternatively, configure the client with individual connection fields.
# BIGQMT_VALKEY_HOST=127.0.0.1
# BIGQMT_VALKEY_PORT=6379
# BIGQMT_VALKEY_DB=5
# BIGQMT_VALKEY_USERNAME=
# BIGQMT_VALKEY_PASSWORD=
# BIGQMT_RPC_TIMEOUT_SECONDS=30
